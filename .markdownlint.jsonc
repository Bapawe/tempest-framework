// Markdown linting for docs/. The custom rules in .markdownlint/rules own the
// checks that need the filesystem or the docs site's own rules: {b`…`}
// references, heading anchors and ids, relative link targets, version-pinned
// links, frontmatter keys and fence languages. See .claude/skills/check-tempest-docs.
{
	"default": true,

	// Prose in docs/ is not hard-wrapped.
	"MD013": false,

	// Code samples are indented with tabs, matching the rest of the repo.
	"MD010": { "code_blocks": false },

	// The docs demonstrate markup, so these elements are expected.
	"MD033": { "allowed_elements": ["code", "pre", "span", "style"] },

	// Owned by doc-fence-language: it understands tempest/highlight's `php{1,10}`
	// line-range syntax and prefers `sh`/`env` over the `bash`/`dotenv` aliases,
	// neither of which MD040's exact-match allowed_languages can express.
	"MD040": false,

	// Owned by doc-link-target: tempestphp.com slugs headings as
	// trim -> strtolower -> str_replace(' ', '-'), keeping backticks and slashes
	// verbatim, which is not the GitHub slug rule MD051 assumes.
	"MD051": false,

	// Custom rules in .markdownlint/rules -- see the comment at the top.
	"doc-link-target": true,
	"doc-reference-url": true,
	"doc-frontmatter": true,
	"doc-fence-language": true,
	"doc-version-link": true,
	"doc-heading-slug": true
}
